# ==================================================
# ECO-SURVEILLANCE MALI — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs.
# ==================================================

# ----------------------------
# DJANGO
# ----------------------------
DJANGO_SECRET_KEY=change-me-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
DJANGO_TIME_ZONE=Africa/Bamako

# ----------------------------
# BASE DE DONNÉES
# ----------------------------
DATABASE_NAME=eco_surveillance
DATABASE_USER=eco_user
DATABASE_PASSWORD=eco_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Fallback SQLite pour dev si Postgres indisponible
USE_SQLITE=1

# ----------------------------
# REDIS / CELERY
# ----------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ----------------------------
# NASA FIRMS
# ----------------------------
FIRMS_MAP_KEY=your-firms-map-key
FIRMS_SOURCE=VIIRS

# ----------------------------
# NASA POWER / ERA5 / CHIRPS
# ----------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
ERA5_CDS_URL=https://cds.climate.copernicus.eu/api/v2
ERA5_CDS_KEY=
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# ----------------------------
# Copernicus Data Space Ecosystem (Sentinel-2, Sentinel-5P)
# ----------------------------
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# ----------------------------
# OpenAQ (optionnel — air quality)
# ----------------------------
OPENAQ_API_KEY=your-openaq-api-key

# ----------------------------
# AWS (optionnel — Landsat S3 Requester Pays)
# ----------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2

# ----------------------------
# IA — OpenAI-compatible (recommandé)
# ----------------------------
AI_PROVIDER=openai_compat
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Groq
# AI_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------
# Google Earth Engine (optionnel)
# ----------------------------
GEE_PROJECT=

# ----------------------------
# Démo Mode (1=activé, 0=désactivé)
# ----------------------------
DEMO_MODE=1
