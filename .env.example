# ==================================================
# ECO-SURVEILLANCE MALI — Variables d'environnement
# Ne jamais écrire de vraies clés API ici.
# ==================================================

# ----------------------------
# DJANGO
# ----------------------------
DJANGO_SECRET_KEY=change-me-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Bamako

# ----------------------------
# BASE DE DONNÉES
# ----------------------------
DATABASE_NAME=eco_surveillance
DATABASE_USER=eco_user
DATABASE_PASSWORD=eco_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Fallback SQLite pour dev si Postgres indisponible
USE_SQLITE=0

# ----------------------------
# REDIS / CELERY
# ----------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ----------------------------
# NASA / COPERNICUS / FIRMS
# ----------------------------
NASA_EARTHDATA_TOKEN=
COPERNICUS_API_KEY=
FIRMS_MAP_KEY=
FIRMS_SOURCE=MODIS, VIIRS

# ----------------------------
# NASA POWER / ERA5 / CHIRPS
# ----------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
ERA5_CDS_URL=https://cds.climate.copernicus.eu/api/v2
ERA5_CDS_KEY=
CHIRPS_BASE_URL=https://chc-ucsb.github.io/chirps-data

# ----------------------------
# OpenAQ (optionnel)
# ----------------------------
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v2

# ----------------------------
# Google Earth Engine (optionnel)
# ----------------------------
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_SERVICE_ACCOUNT_JSON=

# ----------------------------
# IA — Groq par défaut, extensible
# ----------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# Providers IA additionnels possibles :
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
